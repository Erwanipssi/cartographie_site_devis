# Copier ce fichier vers apps/api/.env

DATABASE_URL=postgresql://cartographie:cartographie@localhost:5432/cartographie
REDIS_URL=redis://127.0.0.1:6379

# 127.0.0.1 : API joignable uniquement depuis ce poste. Pour l'ouvrir au réseau (0.0.0.0),
# définissez APP_PASSWORD : l'API refuse de démarrer sinon (voir ALLOW_OPEN_ACCESS).
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

CARTOGRAPHIE_USER_AGENT=CartographieBot/0.1 (+local; audit de contenus)
CRAWL_SITE_CONCURRENCY=2
PDF_CONCURRENCY=4
PDF_MAX_BYTES=52428800
EXPORT_DIR=./data/exports

# Laisser SMTP_HOST vide desactive l'envoi (le bouton reste visible, l'envoi echoue explicitement).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=cartographie@localhost

RUN_MIGRATIONS=false

# Accès protégé par mot de passe (obligatoire dès que l'application est partagée).
APP_PASSWORD=
# Clé de signature des sessions (32 caractères aléatoires ou plus). Vide : nouvelle clé à chaque démarrage.
SESSION_SECRET=
# true autorise une API ouverte au réseau sans mot de passe. Déconseillé.
ALLOW_OPEN_ACCESS=false
